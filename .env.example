# The Gauntlet — Environment Variables
# Copy this file to .env.local to configure server-side default API keys (optional).
# If left empty, users can provide their own keys in the app (BYOK mode)
# or run the built-in offline simulation mode.

# Google Gemini API Key (Recommended - Free Tier Available)
# Obtain at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI API Key (Alternative)
# Obtain at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
