# The Gauntlet — Environment Variables
# Copy this file to .env.local to enable optional server-sponsored Free Live AI.
# If left empty, users can still use Direct-Browser BYOK mode or the offline simulator.

# Google Gemini API Key (Recommended - Free Tier Available)
# Obtain at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenAI API Key (Optional Server Fallback)
# Obtain at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional Upstash Redis REST credentials for distributed serverless rate-limiting
# Recommended on Vercel when GEMINI_API_KEY is enabled publicly
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional daily quota caps (defaults: 12 per IP/day, 500 global/day)
GAUNTLET_FREE_IP_DAILY_LIMIT=12
GAUNTLET_FREE_GLOBAL_DAILY_LIMIT=500
